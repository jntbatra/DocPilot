# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- LLM provider: stub | bedrock | bedrock_mantle ---------------------------
LLM_PROVIDER=bedrock_mantle

# --- bedrock_mantle: Amazon Bedrock Mantle (OpenAI-compatible) ---------------
# Gemma 4 models are served ONLY on the bedrock-mantle endpoint, at /openai/v1.
# Create a long-term API key: Bedrock console → API keys → long-term.
OPENAI_API_KEY=your-bedrock-api-key-here
AWS_REGION=us-east-1
BEDROCK_MANTLE_MODEL=google.gemma-4-31b
# Base URL is built from AWS_REGION automatically. Override only if you must:
# OPENAI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/openai/v1
#
# gemma-4-31b regions: us-east-1, us-east-2, us-west-2, eu-central-1
# 256K context · reasoning · client-side tool calls · 3.5 MB max request body

# --- bedrock: native boto3 Converse API (Claude, Nova, ...) ------------------
# Not usable for Gemma 4 — those models are mantle-only.
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6-v1:0

# --- generation ---------------------------------------------------------------
# Leave unset to use the LLM_PROVIDER above for generation too.
# Set a Gemini key to keep generation on Gemini instead.
# gemini_api_key=
